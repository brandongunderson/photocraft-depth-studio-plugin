{
  "formatVersion": 1,
  "descriptor": {
    "apiVersion": 1,
    "id": "org.photocraft.depth-studio",
    "name": "Depth Map & Depth Blur",
    "version": "1.0.1",
    "author": "Brandon Gunderson",
    "repository": "https://github.com/brandongunderson/photocraft-depth-studio-plugin",
    "updates": {"provider": "github", "asset": "PhotoCraft-Depth-Studio.pcplugin"},
    "description": "Estimate relative scene depth locally with Depth Anything V2 Small. Create a depth map or soften areas away from the chosen focus depth, then preview and apply the result.",
    "permissions": {"documentRead": true, "commands": ["plugin.processImage"]},
    "capabilities": {"required": [{"id": "host.commands.invoke", "minVersion": 1}], "optional": []},
    "panel": {
      "preview": true,
      "fields": [
        {"id": "output", "label": "Result", "type": "choice", "options": ["Depth blur", "Depth map"], "default": "Depth blur"},
        {"id": "focus", "label": "Focus depth (0 far, 1 near)", "type": "number", "min": 0, "max": 1, "default": 0.65},
        {"id": "range", "label": "Sharp depth range", "type": "number", "min": 0, "max": 1, "default": 0.1},
        {"id": "radius", "label": "Maximum blur radius (pixels)", "type": "int", "min": 0, "max": 64, "default": 16},
        {"id": "side", "label": "Blur areas", "type": "choice", "options": ["Background only", "Foreground and background"], "default": "Background only"},
        {"id": "invert", "label": "Invert depth map (near is dark)", "type": "bool", "default": false}
      ],
      "buttons": [{"id": "generate", "label": "Create result"}]
    }
  },
  "package": {"packageVersion": 2, "module": "plugin.pcext", "native": {"service": "plugin.processImage", "platform": "windows-x86_64", "entry": "depth-studio-worker.exe"}}
}
